includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src/
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # A package config file is the one place env() belongs; Larastan only
        # recognises the host app's config directory as such.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/upkeep-agent.php
